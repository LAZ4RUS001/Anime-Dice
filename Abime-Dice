-- Mobile & Delta Draggable Floating Toggle Button
pcall(function()
    local toggleGuiName = "StreetHubMobileToggle"
    local existingToggle = PlayerGui and PlayerGui:FindFirstChild(toggleGuiName)
    if existingToggle then existingToggle:Destroy() end

    local toggleGui = Instance.new("ScreenGui")
    toggleGui.Name = toggleGuiName
    toggleGui.ResetOnSpawn = false
    toggleGui.DisplayOrder = 9999
    toggleGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

    local StreetHubIconB64 = [==[

]==]

    local floatBtnIcon = "rbxasset://textures/streethub_icon.png"
    pcall(function()
        local iconFilePath = "StreetHub/streethub_icon.png"
        local decodeFn = crypt and crypt.base64decode or base64_decode or (syn and syn.crypt and syn.crypt.base64_decode)
        local getAssetFn = getcustomasset or getsynasset
        if decodeFn and writefile then
            local decodedBytes = decodeFn(StreetHubIconB64)
            local needWrite = true
            if isfile and readfile and isfile(iconFilePath) then
                local existing = readfile(iconFilePath)
                if existing and #existing == #decodedBytes then
                    needWrite = false
                end
            end
            if needWrite then
                writefile(iconFilePath, decodedBytes)
            end
            if getAssetFn then
                local customAsset = getAssetFn(iconFilePath)
                -- On Delta mobile / executors that support custom asset URI:
                if customAsset and tostring(customAsset) ~= "" and not string.find(tostring(customAsset), "rbxasset://%x%x%x%x") then
                    floatBtnIcon = customAsset
                end
            end
        end
    end)

    local floatBtn = Instance.new("ImageButton")
    floatBtn.Name = "ToggleButton"
    floatBtn.Size = UDim2.fromOffset(50, 50)
    floatBtn.Position = UDim2.new(0.015, 0, 0.22, 0)
    floatBtn.BackgroundColor3 = Color3.fromRGB(15, 17, 22)
    floatBtn.BorderSizePixel = 0
    floatBtn.AutoButtonColor = true
    floatBtn.Image = floatBtnIcon
    floatBtn.ImageColor3 = Color3.fromRGB(255, 255, 255)
    floatBtn.Active = true

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 12)
    btnCorner.Parent = floatBtn

    local btnStroke = Instance.new("UIStroke")
    btnStroke.Color = Color3.fromRGB(255, 35, 45)
    btnStroke.Thickness = 1.5
    btnStroke.Parent = floatBtn

    -- Draggable Logic for Mobile Touch & PC Mouse
    local dragging = false
    local dragInput, dragStart, startPos
    local hasMoved = false

    floatBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            hasMoved = false
            dragStart = input.Position
            startPos = floatBtn.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    floatBtn.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            if math.abs(delta.X) > 4 or math.abs(delta.Y) > 4 then
                hasMoved = true
            end
            floatBtn.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)

    floatBtn.Activated:Connect(function()
        if not hasMoved then
            if Window.Root then
                Window.Root.Visible = not Window.Root.Visible
            elseif Fluent.GUI then
                Fluent.GUI.Enabled = not Fluent.GUI.Enabled
            end
        end
    end)

    floatBtn.Parent = toggleGui
    toggleGui.Parent = PlayerGui or game:GetService("CoreGui")
    _G.StreetHubMobileToggleGui = toggleGui
end)

