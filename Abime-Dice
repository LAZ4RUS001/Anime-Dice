local AccountConfigFolder = "StreetHub/accounts"
local AccountConfigFile = string.format("%s/%s.json", AccountConfigFolder, AccountKey)

local function EnsureDirectories()
    pcall(function()
        if makefolder then
            if isfolder and not isfolder("StreetHub") then
                makefolder("StreetHub")
            end
            if isfolder and not isfolder(AccountConfigFolder) then
                makefolder(AccountConfigFolder)
            end
            if isfolder and not isfolder("StreetHub/fluent") then
                makefolder("StreetHub/fluent")
            end
        end
    end)
end

local function LoadAccountConfig()
    EnsureDirectories()
    pcall(function()
        if isfile and readfile and isfile(AccountConfigFile) then
            local raw = readfile(AccountConfigFile)
            if raw and raw ~= "" then
                local data = HttpService:JSONDecode(raw)
                if type(data) == "table" then
                    for k, v in pairs(data) do
                        if Config[k] ~= nil then
                            Config[k] = v
                        end
                    end
                end
            end
        end
    end)
end

