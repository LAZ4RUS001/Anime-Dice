local function CheckAndCleanInventory()
    if not Config.AutoClearFullInv then return end
    pcall(function()
        local inv = DataController.Inventory()
        local unitStorage = BuffController.GetBuff("Unit Storage") or 100
        local toSell = {}
        local count = 0
        for id, unit in pairs(inv) do
            local cfg = EntryRegistry.getEntryConfig(unit.name)
            if cfg and cfg.kind == "Unit" then
                count = count + 1
                if not unit.locked and (unit.equipped ~= true) then
                    table.insert(toSell, id)
                end
            end
        end
        if count >= (unitStorage - 3) and #toSell > 0 then
            SellInventoryRF(toSell)
        end
    end)
end

local function EquipBestDice()
    pcall(function()
        local owned = DataController.OwnedDice and DataController.OwnedDice() or {}
        local allDice = DiceConfig.GetAll and DiceConfig.GetAll() or {}
        local bestName = nil
        local bestLuck = -1

        for dName, isOwned in pairs(owned) do
            if isOwned and allDice[dName] then
                local luck = allDice[dName].luck or 0
                if luck > bestLuck then
                    bestLuck = luck
                    bestName = dName
                end
            end
        end

        if bestName and DataController.Dice and DataController.Dice() ~= bestName then
            EquipDiceRE:FireServer(bestName)
        end
    end)
end

