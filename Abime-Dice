-- Worker: Upgrades & Rebirth
task.spawn(function()
    while _G.StreetHubDiceRunning do
        if Config.AutoBuyUpgrades then
            pcall(function()
                local currentMoney = DataController.Money()
                for name, data in pairs(UpgradesConfig) do
                    local isOwned = DataController.Upgrades[name] and DataController.Upgrades[name]()
                    if not isOwned and data.price and data.price <= currentMoney then
                        local parents = TreeStructure.GetParents and TreeStructure.GetParents(name) or {}
                        local canBuy = (#parents == 0)
                        for _, p in ipairs(parents) do
                            if p == "Start" or (DataController.Upgrades[p] and DataController.Upgrades[p]()) then
                                canBuy = true
                                break
                            end
                        end
                        if canBuy then
                            BuyUpgradeRE:FireServer(name)
                            task.wait(0.05)
                        end
                    end
                end
            end)
        end

        if Config.AutoRebirth then
            pcall(function()
                local curRb = DataController.Rebirth and DataController.Rebirth()
                local myCash = DataController.Money and DataController.Money() or 0
                if curRb and Rebirths and Rebirths.GetNext then
                    local nextRb = Rebirths.GetNext(curRb)
                    if nextRb and nextRb.cost and myCash >= nextRb.cost then
                        RebirthRE:FireServer()
                    end
                else
                    RebirthRE:FireServer()
                end
            end)
        end
        task.wait(1)
    end
end)

-- Worker: Towers (Dungeon Raider)
task.spawn(function()
    local inTower = false
    while _G.StreetHubDiceRunning do
        if Config.AutoTower then
            if not inTower then
                if Config.AutoTowerEquipBest then
                    pcall(function()
                        EquipBestTowerTeamSignal:Fire()
                    end)
                    task.wait(0.5)
                end

                local success, started = pcall(function()
                    return PlayTowerFunc(Config.SelectedTower or "Infinity Tower")
                end)

                if success and started then
                    inTower = true
                else
                    pcall(function()
                        CancelTowerFunc()
                        CompleteTowerFloorFunc()
                    end)
                    task.wait(3.5)
                end
            else
                local delay = Config.FastTowerClear and 0.6 or 1.5
                task.wait(delay)
                local success, res = pcall(CompleteTowerFloorFunc)
                if success and type(res) == "table" and #res > 0 then
                    for _, act in ipairs(res) do
                        if act.action == "ended" then
                            inTower = false
                            task.wait(3.5)
                            break
                        end
                    end
                end
            end
        else
            inTower = false
            task.wait(1.0)
        end
    end
end)

