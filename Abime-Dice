local function SafeUpdateElement(elem, title, desc)
    if not elem then return end
    pcall(function()
        if title and elem.SetTitle then elem:SetTitle(title) end
        if desc and elem.SetDesc then elem:SetDesc(desc) end
        if elem.Type == "Section" and title and elem.Container and elem.Container.Parent then
            local lbl = elem.Container.Parent:FindFirstChildWhichIsA("TextLabel")
            if lbl then lbl.Text = title end
        end
    end)
end

UpdateLanguage = function(newLang)
    Config.Language = (newLang == "Thai") and "Thai" or "English"

    -- Update Tab Names
    local tabPairs = {
        { Tabs.Roll, GetText("TabRoll") },
        { Tabs.Plot, GetText("TabPlot") },
