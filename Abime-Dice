-- Worker: Auto Potion & Boosts
task.spawn(function()
    while _G.StreetHubDiceRunning do
        if Config.AutoPotion and Config.SelectedPotions then
            pcall(function()
                local active = DataController.ActiveEntries and DataController.ActiveEntries() or {}
                local inv = DataController.Inventory and DataController.Inventory() or {}
                local now = workspace:GetServerTimeNow()

                -- Build quick inventory counts
                local invCounts = {}
                for _, item in pairs(inv) do
                    if item.name then
                        invCounts[item.name] = (invCounts[item.name] or 0) + (item.amount or 1)
                    end
                end

                for potionName, enabled in pairs(Config.SelectedPotions) do
                    if enabled == true and (invCounts[potionName] or 0) > 0 then
                        local entry = active[potionName]
                        local isCurrentlyActive = false
                        if entry and type(entry) == "table" and entry.remaining and entry.startedAt then
                            if (entry.remaining - (now - entry.startedAt)) > 3 then
                                isCurrentlyActive = true
                            end
                        end

                        if not isCurrentlyActive then
                            if BoostController and BoostController.UseBoost then
                                BoostController.UseBoost(potionName)
                            elseif UseBoostRE then
                                UseBoostRE:FireServer(potionName)
                            end
                            task.wait(0.2)
                        end
                    end
                end
            end)
            task.wait(2.5)
        else
            task.wait(2.0)
        end
    end
end)

