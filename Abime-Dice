local function GetText(key, ...)
    local langKey = (Config.Language == "Thai") and "TH" or "EN"
    local tbl = Locales[langKey] or Locales.EN
    local str = tbl[key] or Locales.EN[key] or Locales.TH[key] or key
    if select("#", ...) > 0 then
        return string.format(str, ...)
    end
    return str
end

