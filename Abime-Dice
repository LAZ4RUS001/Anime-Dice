-- Worker: Fast Roll
local isRollingMutex = false
task.spawn(function()
    while _G.StreetHubDiceRunning do
        if Config.FastRoll then
            if not isRollingMutex then
                isRollingMutex = true
                pcall(function()
                    CheckAndCleanInventory()
                    local res = RollDiceFunc()
                    if res and type(res) == "table" and res[1] then
                        if not Config.SkipRollAnimation then
                            local rollBtn = UIReferences.Root.HUD.Bottom.Roll
                            safeFireSignal(rollBtn.Activated)
                        end
                        local servDuration = BuffController.GetBuff("Roll Duration") or 2.5
                        task.wait(math.max(servDuration - 0.08, Config.FastRollDelay))
                    else
                        task.wait(0.12)
                    end
                end)
                isRollingMutex = false
            else
                task.wait(0.05)
            end
        else
            task.wait(0.3)
        end
    end
end)

